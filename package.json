{
  "name": "@sulthonzh/function-x",
  "version": "1.1.0",
  "description": "Zero-dependency higher-order function utilities for currying, composition, memoization, debouncing, throttling, and rate limiting. 50 tests, 100% pass rate — all in <6KB with zero dependencies.",
  "type": "module",
  "main": "function-x.js",
  "exports": {
    ".": {
      "import": "./function-x.js",
      "require": "./function-x.js"
    }
  },
  "bin": {
    "function-x": "cli.js"
  },
  "files": [
    "function-x.js",
    "cli.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test.js test/coverage-gaps.test.js test/coverage-gaps-2.test.js",
    "test:coverage": "c8 --include='function-x.js' --include='cli.js' node --test test.js test/coverage-gaps.test.js test/coverage-gaps-2.test.js",
    "test:core": "node --test test.js",
    "prepublishOnly": "npm test",
    "demo": "node cli.js demo"
  },
  "keywords": [
    "functional",
    "higher-order",
    "currying",
    "partial",
    "composition",
    "memoization",
    "utils",
    "zero-dependencies"
  ],
  "author": "Sulthonzh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sulthonzh/function-x.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/sulthonzh/function-x#readme",
  "bugs": {
    "url": "https://github.com/sulthonzh/function-x/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "c8": "^12.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
